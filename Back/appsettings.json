{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*",
  "Storage": { "DataDirectory": "App_Data" },
  "Conversion": {
    "ValidationSlots": 2,
    "ConversionSlots": 2,
    "PreflightTimeoutSeconds": 30,
    "TimeoutSeconds": 60
  }
}
