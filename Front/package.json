{
  "name": "inkstone-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-notices.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-notices.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "editor:build": "node scripts/build-editor.mjs",
    "editor:optimize": "node scripts/build-editor.mjs --optimize",
    "build:all": "npm run editor:build && npm run build",
    "format": "prettier --write src public/editor-host.js vite.config.js scripts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  }
}
